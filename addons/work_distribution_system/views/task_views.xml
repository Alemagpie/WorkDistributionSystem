<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!--Header fields-->
            <xpath expr="//header" position="inside">
                <button name="save_changes" type="object" string="Salva modifiche"/>
            </xpath>

            <!--Form fields-->
            <xpath expr="//field[@name='description']" position="before">
            <div id="email_print_area">
                <group>
                    <field name="id" string="ID Lavoro" readonly="1"/>
                </group>
                <separator/>
                <group>
                    <field name="status" readonly="1"/>
                    <field name="priority" string="Priorità"/>
                    <field name="date_deadline" string="Scadenza"/>
                </group>
                <separator/>
                <group col="3">
                    <field name="arrive_date" readonly="1"/>
                    <field name="create_date" string="Data e ora di creazione" readonly="1"/>
                    <field name="write_date" string="Ultima modifica" readonly="1"/>
                </group>
                <separator/>
                <group>
                    <field name="mail_sender" string="Mittente" readonly="1"/>
                    <field name="mail_subject" string="Oggetto" readonly="1"/>
                    <field name="mail_body" string="Corpo" readonly="1"/>
                </group>
                <separator/>
                <group>
                    <field name="mail_attach_count" readonly="1"/>
                    <separator/>
                    <!--<button name="download_all_attachments" title="Scarica tutto" type="object" id="download_btn" attrs="{'invisible': [('mail_attach_count', '=', 0)]}"/>-->
                    <field name="mail_attach_ids" readonly="1" attrs="{'invisible': [('mail_attach_count', '=', 0)]}">
                        <tree>
                            <field name="name" string="Nome file"/>
                            <field name="mimetype" string="Tipo"/>
                            <field name="file_size" string="Dimensione (MB)"/>
                            <button name="action_download" title="Scarica allegati" type="object" id="download_btn"/>
                        </tree>
                    </field>
                </group>
            </div>
            </xpath>

            <xpath expr="//field[@name='description']" position="after">
                <separator/>
                <div>
                    <button name="archive_task" title="Archivia task" type="object" class="bottom_btn" id="btn_archive" attrs="{'invisible': [('active', '=', False)]}"/>
                    <button name="unarchive_task" title="Disarchivia task" type="object" class="bottom_btn" id="btn_unarchive" attrs="{'invisible': [('active', '=', True)]}"/>
                    <button name="delete_task" title="Cancella task" type="object" class="bottom_btn" id="btn_delete" confirm="Sei sicuro di voler eliminare questo task? L'operazione non può essere annullata."/>
                    <button name="send_response_it"  title="Invia risposta in italiano" type="object" class="bottom_btn" id="btn_send_it"/>
                    <button name="send_response_eng"  title="Invia risposta in inglese" type="object" class="bottom_btn" id="btn_send_eng"/>
                    <button name="%(action_print_task)d" title="Stampa" type="action" class="bottom_btn" id="btn_print"/>
                </div>
            </xpath>

            <!-- Hide default fields -->
            <xpath expr="//*[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='project_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!--<xpath expr="//*[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>-->
            <xpath expr="//*[@name='task_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>