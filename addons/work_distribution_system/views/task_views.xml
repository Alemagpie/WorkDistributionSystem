<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!--Header fields-->
            <xpath expr="//header" position="inside">
                <button name="save_changes" type="object" string="Salva modifiche"/>
            </xpath>

            <!--Form fields-->
            <xpath expr="//field[@name='description']" position="before">
                <group>
                    <field name="id" string="ID Lavoro" readonly="1"/>
                </group>
                <separator/>
                <group>
                    <field name="status" readonly="1"/>
                    <field name="priority" string="Priorità"/>
                    <field name="date_deadline" string="Scadenza"/>
                </group>
                <separator/>
                <group col="3">
                    <field name="arrive_date" readonly="1"/>
                    <field name="create_date" string="Data e ora di creazione" readonly="1"/>
                    <field name="write_date" string="Ultima modifica" readonly="1"/>
                </group>
                <separator/>
                <group>
                    <field name="mail_sender" string="Mittente" readonly="1"/>
                    <field name="mail_subject" string="Oggetto" readonly="1"/>
                    <field name="mail_body" string="Corpo" readonly="1"/>
                </group>
                <separator/>
                <group>
                    <field name="mail_attach_count" readonly="1"/>
                    <button name="send_response_it" type="object" id="download_btn" attrs="{'invisible': [('mail_attach_count', '=', '0')]}"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='description']" position="after">
                <separator/>
                <group>
                    <button name="send_response_it" type="object" class="bottom_btn btn_send_it"/>
                    <button name="send_response_eng" type="object" class="bottom_btn btn_send_eng"/>
                </group>
            </xpath>

            <!-- Hide default fields -->
            <xpath expr="//*[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='project_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//*[@name='task_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>